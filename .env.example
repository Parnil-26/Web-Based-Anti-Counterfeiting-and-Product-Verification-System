# Neon PostgreSQL Connection URLs
DATABASE_URL="postgres://user:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:password@ep-example.region.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Application Server Configuration
PORT=5000
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Public / Base Verification URL for QR Codes
# In local development: http://localhost:5000 (Express production/unified server) or http://localhost:3000 (Vite)
# In production: https://your-domain.com
APP_URL="http://localhost:5000"
